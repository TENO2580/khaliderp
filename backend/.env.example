# ─── TRIPIDIO ERP ENVIRONMENT CONFIGURATION ───
PORT=5000
NODE_ENV=development

# ─── DATABASE CONNECTION (SUPABASE / POSTGRESQL) ───
# Replace with your Supabase Connection String from Supabase Dashboard -> Project Settings -> Database
# Example: DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── SUPABASE API KEYS (OPTIONAL FOR STORAGE & REALTIME) ───
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── JWT AUTHENTICATION ───
JWT_SECRET="tripidio_erp_jwt_secret_key_2026_super_secure_987654321"
JWT_REFRESH_SECRET="tripidio_erp_refresh_secret_key_2026_super_secure_123456789"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS ALLOWED ORIGINS ───
CORS_ORIGIN="http://localhost:3000"
