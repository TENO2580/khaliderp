// ============================================
// Khalid ERP — Prisma Schema
// Candle Manufacturing Cloud ERP
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTICATION & AUTHORIZATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  googleId      String?
  name          String
  phone         String?
  avatar        String?
  role          UserRole  @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  refreshToken  String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  notifications Notification[]
  createdNotifications Notification[] @relation("NotificationCreator")
  auditLogs     AuditLog[]
  expenses      Expense[]           @relation("ExpenseCreator")
  approvedExpenses Expense[]        @relation("ExpenseApprover")
  productions   Production[]
  employee      Employee?

  @@index([role])
  @@index([isActive])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PRODUCTION_MANAGER
  SALES_EXECUTIVE
  WAREHOUSE
  ACCOUNTANT
  EMPLOYEE
}

// ============================================
// CUSTOMER CRM
// ============================================

model Customer {
  id              String         @id @default(cuid())
  customerId      String         @unique // e.g., CUST-0001
  name            String
  ownerName       String?
  phone           String?
  whatsapp        String?
  email           String?
  gstNumber       String?
  address         String?
  district        String?
  state           String?
  pincode         String?
  route           String?        // Field for location-wise classification (e.g., Areekode, Mukkam)
  latitude        Float?
  longitude       Float?
  type            CustomerType   @default(RETAILER)
  currentBrand    String?
  sellingPrice    Float?         @default(0)
  creditLimit     Float          @default(0)
  outstanding     Float          @default(0)
  status          CustomerStatus @default(LEAD)
  lastPurchaseDate DateTime?
  nextFollowupDate DateTime?
  notes           String?
  attachments     String?        // URLs from Supabase Storage
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  followups       CustomerFollowup[]
  salesOrders     SalesOrder[]
  invoices        Invoice[]
  payments        Payment[]

  @@index([name])
  @@index([status])
  @@index([type])
  @@index([route])
  @@map("customers")
}

enum CustomerType {
  DISTRIBUTOR
  RETAILER
  WHOLESALER
  DEALER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
  LOST
}

model CustomerFollowup {
  id          String    @id @default(cuid())
  customerId  String
  type        FollowupType
  notes       String?
  nextDate    DateTime?
  completedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_followups")
}

enum FollowupType {
  CALL
  VISIT
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

// ============================================
// PRODUCTS & RAW MATERIALS
// ============================================

model Product {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  category    String?
  unit        String    @default("KG")
  description String?
  hsnCode     String?
  gstRate     Float     @default(18)
  sellingPrice Float    @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  inventory       Inventory?
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]
  batchProducts   Batch[]

  @@index([name])
  @@map("products")
}

model RawMaterial {
  id           String             @id @default(cuid())
  name         String
  category     RawMaterialCategory
  unit         String             @default("KG")
  currentStock Float              @default(0)
  minimumStock Float              @default(0)
  reorderLevel Float              @default(0)
  unitCost     Float              @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@index([category])
  @@map("raw_materials")
}

enum RawMaterialCategory {
  WAX
  COLOR
  FRAGRANCE
  CONTAINER
  WICK
  BOX
  LABEL
  OTHER
}

// ============================================
// INVENTORY
// ============================================

model Inventory {
  id           String    @id @default(cuid())
  productId    String    @unique
  currentStock Float     @default(0)
  minimumStock Float     @default(0)
  reorderLevel Float     @default(0)
  unitCost     Float     @default(0)
  value        Float     @default(0) // currentStock * unitCost
  lastUpdated  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([lastUpdated])
  @@map("inventory")
}

model StockMovement {
  id             String        @id @default(cuid())
  inventoryId    String?
  rawMaterialId  String?
  type           MovementType
  quantity       Float
  reference      String?       // e.g., "Production #P-0001" or "Sales Order #SO-0001"
  referenceId    String?
  notes          String?
  createdBy      String?
  createdAt      DateTime      @default(now())

  // Relations
  inventory      Inventory?    @relation(fields: [inventoryId], references: [id])
  rawMaterial    RawMaterial?  @relation(fields: [rawMaterialId], references: [id])

  @@index([inventoryId])
  @@index([rawMaterialId])
  @@index([type])
  @@map("stock_movements")
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  PRODUCTION_IN     // Finished goods from production
  PRODUCTION_OUT    // Raw materials consumed
  SALES_OUT         // Sold goods
  PURCHASE_IN       // Purchased materials
  RETURN_IN         // Customer returns
}

// ============================================
// PRODUCTION & BATCHES
// ============================================

model Batch {
  id             String      @id @default(cuid())
  batchNumber    String      @unique // e.g., BATCH ZERO, BATCH ONE
  productId      String?
  purchaseDate   DateTime
  waxInitialQty  Float       @default(0)
  waxRate        Float       @default(0)
  sellingPrice   Float       @default(0)
  producedQty    Float       @default(0)
  soldQty        Float       @default(0)
  remainingQty   Float       @default(0)
  waxStock       Float       @default(0)
  productionCost Float       @default(0) // waxInitialQty * waxRate
  status         BatchStatus @default(IN_PRODUCTION)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  product        Product?         @relation(fields: [productId], references: [id])
  productions    Production[]
  salesOrderItems SalesOrderItem[]

  @@index([status])
  @@index([purchaseDate])
  @@map("batches")
}

enum BatchStatus {
  IN_PRODUCTION
  COMPLETED
  PARTIALLY_SOLD
  FULLY_SOLD
  EXPIRED
}

model Production {
  id              String    @id @default(cuid())
  productionNumber String   @unique // e.g., PROD-2026-0001
  date            DateTime
  batchId         String
  operatorId      String
  shift           Shift     @default(DAY)

  // Materials used
  waxUsed         Float     @default(0)
  fragranceUsed   Float     @default(0)
  colorUsed       Float     @default(0)
  containerUsed   Float     @default(0)
  wickUsed        Float     @default(0)

  // Costs
  labourCost      Float     @default(0)
  gasCost         Float     @default(0)
  electricityCost Float     @default(0)
  otherCosts      Float     @default(0)
  totalCost       Float     @default(0)

  // Output
  quantityProduced Float    @default(0)
  costPerKg        Float    @default(0)
  sellingPrice     Float    @default(0)
  profit           Float    @default(0)
  margin           Float    @default(0) // percentage

  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  batch            Batch    @relation(fields: [batchId], references: [id])
  operator         User     @relation(fields: [operatorId], references: [id])

  @@index([date])
  @@index([batchId])
  @@map("productions")
}

enum Shift {
  DAY
  NIGHT
  MORNING
  EVENING
}

// ============================================
// SALES & INVOICES
// ============================================

model SalesOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique // e.g., SO-2026-0001
  customerId      String
  orderDate       DateTime       @default(now())
  deliveryDate    DateTime?
  subtotal        Float          @default(0)
  discount        Float          @default(0)
  discountPercent Float          @default(0)
  taxableAmount   Float          @default(0)
  cgst            Float          @default(0)
  sgst            Float          @default(0)
  igst            Float          @default(0)
  totalGst        Float          @default(0)
  transportCharge Float          @default(0)
  totalAmount     Float          @default(0)
  paymentMethod   PaymentMethod  @default(CREDIT)
  paymentStatus   PaymentStatus  @default(UNPAID)
  creditAmount    Float          @default(0)
  paidAmount      Float          @default(0)
  outstanding     Float          @default(0)
  status          OrderStatus    @default(PENDING)
  notes           String?
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  customer        Customer       @relation(fields: [customerId], references: [id])
  items           SalesOrderItem[]
  invoice         Invoice?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  orderId      String
  productId    String
  batchId      String?
  quantity     Float
  unitPrice    Float
  discount     Float      @default(0)
  gstRate      Float      @default(18)
  gstAmount    Float      @default(0)
  amount       Float      @default(0)
  createdAt    DateTime   @default(now())

  // Relations
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
  batch        Batch?     @relation(fields: [batchId], references: [id])

  @@map("sales_order_items")
}

enum PaymentMethod {
  CASH
  CREDIT
  UPI
  BANK_TRANSFER
  CHEQUE
  NEFT
  RTGS
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
  OVERDUE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // e.g., INV-2026-0001
  orderId       String        @unique
  customerId    String
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float         @default(0)
  cgst          Float         @default(0)
  sgst          Float         @default(0)
  igst          Float         @default(0)
  totalGst      Float         @default(0)
  transportCharge Float       @default(0)
  totalAmount   Float         @default(0)
  paidAmount    Float         @default(0)
  outstanding   Float         @default(0)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  order         SalesOrder    @relation(fields: [orderId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  CANCELLED
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String
  description String?
  hsnCode     String?
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  taxableAmount Float  @default(0)
  gstRate     Float    @default(18)
  cgst        Float    @default(0)
  sgst        Float    @default(0)
  igst        Float    @default(0)
  amount      Float    @default(0)

  // Relations
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  customerId  String
  amount      Float
  method      PaymentMethod
  reference   String?       // Transaction ID, cheque number, etc.
  date        DateTime      @default(now())
  notes       String?
  createdBy   String?
  createdAt   DateTime      @default(now())

  // Relations
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])

  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

// ============================================
// EXPENSES
// ============================================

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String?
  color     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  // Relations
  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String    @id @default(cuid())
  categoryId  String
  amount      Float
  date        DateTime
  description String?
  receiptUrl  String?
  createdById String
  approvedById String?
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy  User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// EMPLOYEES & HR
// ============================================

model Employee {
  id          String         @id @default(cuid())
  employeeId  String         @unique // e.g., EMP-0001
  userId      String?        @unique
  name        String
  phone       String?
  email       String?
  address     String?
  designation String?
  department  String?
  salary      Float          @default(0)
  joinDate    DateTime
  exitDate    DateTime?
  status      EmployeeStatus @default(ACTIVE)
  bankAccount String?
  ifscCode    String?
  aadharNumber String?
  panNumber   String?
  emergencyContact String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  user        User?          @relation(fields: [userId], references: [id])
  attendance  Attendance[]

  @@index([status])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  checkIn    DateTime?
  checkOut   DateTime?
  hoursWorked Float?
  overtime    Float?
  targetKg    Float     @default(0)
  actualKg    Float     @default(0)
  dailySalary Float     @default(0)
  notes       String?
  createdAt  DateTime         @default(now())

  // Relations
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
}

// ============================================
// SUPPLIERS & PURCHASES
// ============================================

model Supplier {
  id          String    @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  gstNumber   String?
  address     String?
  state       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNumber      String              @unique // e.g., PO-2026-0001
  supplierId    String
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  subtotal      Float               @default(0)
  gstAmount     Float               @default(0)
  totalAmount   Float               @default(0)
  paidAmount    Float               @default(0)
  outstanding   Float               @default(0)
  status        PurchaseOrderStatus @default(DRAFT)
  paymentStatus PaymentStatus       @default(UNPAID)
  notes         String?
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Float
  unitPrice       Float
  gstRate         Float         @default(18)
  gstAmount       Float         @default(0)
  amount          Float         @default(0)
  receivedQty     Float         @default(0)

  // Relations
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@map("purchase_items")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ============================================
// NOTIFICATIONS & AUDIT
// ============================================

model Notification {
  id            String               @id @default(cuid())
  companyId     String?
  branchId      String?
  userId        String?
  role          UserRole?
  module        NotificationModule
  category      String
  priority      NotificationPriority @default(MEDIUM)
  title         String
  message       String
  referenceType String?              // e.g., "SalesOrder", "Batch", "Inventory"
  referenceId   String?
  link          String?
  icon          String?
  color         String?              // hex or tailwind class
  isRead        Boolean              @default(false)
  isArchived    Boolean              @default(false)
  isPinned      Boolean              @default(false)
  readAt        DateTime?
  expiresAt     DateTime?
  metadata      Json?
  
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  user          User?                @relation(fields: [userId], references: [id])
  createdBy     User?                @relation("NotificationCreator", fields: [createdById], references: [id])

  @@index([userId, isRead])
  @@index([role, isRead])
  @@index([module])
  @@index([priority])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NotificationModule {
  DASHBOARD
  SALES
  CUSTOMERS
  PRODUCTION
  INVENTORY
  PURCHASE
  FINANCE
  HR
  TASKS
  SYSTEM
  AI
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // Table name
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  label     String?
  type      String   @default("text") // text, number, boolean, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ============================================
// PRICING & UNIT ECONOMICS
// ============================================

model CostingProfile {
  id               String   @id @default(cuid())
  name             String   @default("Default Pricing")
  waxCost          Float    @default(154.00)
  otherMaterials   Float    @default(1.00)
  labourCost       Float    @default(7.00)
  electricityCost  Float    @default(2.00)
  energyCost       Float    @default(1.00) // Gas/Wood
  transportCost    Float    @default(2.00)
  packagingOverhead Float   @default(10.00)
  sellingPrice     Float    @default(195.00)
  updatedAt        DateTime @updatedAt
  
  caseVariants     CaseVariant[]

  @@map("costing_profiles")
}

model CaseVariant {
  id               String   @id @default(cuid())
  profileId        String
  name             String   // e.g., "2 RS CASE"
  weightKg         Float    // e.g., 0.72
  prodCostPerKg    Float?   // Optional override for Prod Cost/KG
  sellingPrice     Float    // e.g., 228.00
  
  profile          CostingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("case_variants")
}
